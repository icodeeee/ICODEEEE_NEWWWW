# --- Site ---------------------------------------------------------------
# Optional explicit public origin. Vercel's production domain is used when
# unset, so deployments still get correct canonicals and sitemap URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Without it, POST /api/leads returns 503 and every enquiry fails.
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta Ads tracking ---------------------------------------------------
# Public pixel ID. Leave blank to keep all advertising scripts inert locally.
# Nothing loads until the visitor accepts analytics cookies.
NEXT_PUBLIC_META_PIXEL_ID=
# Server-side Conversions API token. Sent only after a lead is durably stored.
META_CAPI_TOKEN=
# While testing events in Events Manager, set the event code from Test Events.
META_CAPI_TEST_EVENT_CODE=

# --- Contact routes ------------------------------------------------------
# Phone and WhatsApp render as direct links. Use an international-format number
# for WhatsApp so the wa.me link works across countries.
NEXT_PUBLIC_CONTACT_EMAIL=icodeeee@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=+91 7011609990
NEXT_PUBLIC_CONTACT_LOCATION=

# --- Email notifications -------------------------------------------------
# Optional. Lead notifications are skipped entirely if any of these are unset.
RESEND_API_KEY=
LEADS_FROM_EMAIL=Icodeee <hello@your-domain.com>
